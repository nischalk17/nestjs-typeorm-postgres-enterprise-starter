# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=9095
API_PREFIX=api
API_VERSION=1
# Comma-separated list of allowed CORS origins. Supports "*.example.com" wildcard
# subdomains and "*" to allow any origin (not recommended in production).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional: single extra origin always allowed (e.g. a temporary ngrok tunnel URL).
# NGROK_ORIGIN=https://abcd1234.ngrok-free.app

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_DATABASE=starter_db
# DB_SCHEMA=public
DB_SYNCHRONIZE=false
# SSL: enabled automatically in production. Set DB_SSL=true to force it elsewhere.
DB_SSL=false
# In production self-signed certs are rejected by default; set false to allow them.
DB_SSL_REJECT_UNAUTHORIZED=true

# ---------------------------------------------------------------------------
# JWT / Auth (Bearer tokens)
# ---------------------------------------------------------------------------
# Use a strong random string (min 16 chars): openssl rand -base64 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32
JWT_EXPIRATION=15m
# Optional: defaults to `${JWT_SECRET}_refresh` if omitted
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_STRONG_SECRET
JWT_REFRESH_EXPIRATION=7d
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Mail (Nodemailer / SMTP)
# ---------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=youremail@gmail.com
MAIL_PASSWORD=generated_app_password
MAIL_FROM=No Reply <no-reply@example.com>

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=5
# Comma-separated MIME allowlist (defaults applied if omitted)
# UPLOAD_ALLOWED_MIMETYPES=image/jpeg,image/png,application/pdf

# ---------------------------------------------------------------------------
# Throttler (rate limiting)
# ---------------------------------------------------------------------------
# Defaults: enabled in production only
THROTTLE_ENABLED=false
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ---------------------------------------------------------------------------
# Seeding (npm run db:seed)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345

# ---------------------------------------------------------------------------
# Redis (OPTIONAL - cache/queue scaffolding, disabled by default)
# ---------------------------------------------------------------------------
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TTL=60
